{
  "name": "yumbry",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared",
    "e2e"
  ],
  "scripts": {
    "release": "bash scripts/release.sh",
    "e2e:build": "npm run build --workspace=shared && npm run build --workspace=frontend && npm run build --workspace=backend",
    "e2e": "npm run test --workspace=e2e",
    "e2e:ui": "npm run test:ui --workspace=e2e"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true
  },
  "version": "1.1.0"
}
