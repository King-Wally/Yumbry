{
	"name": "yumbry",
	"private": true,
	"version": "2.0.2",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun scripts/serve.ts",
		"release": "scripts/release.sh",
		"prepare": "svelte-kit sync && bun scripts/paraglide-compile.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "bun --bun vitest",
		"test": "bun run test:unit --run",
		"db:start": "docker compose up -d db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"e2e:build": "bun run build",
		"e2e": "bun src/e2e/scripts/prepare.ts && bun --bun playwright test",
		"e2e:ui": "bun src/e2e/scripts/prepare.ts && bun --bun playwright test --ui"
	},
	"dependencies": {
		"better-auth": "^1.7.12",
		"drizzle-orm": "^0.45.4",
		"openai": "^7.42.0",
		"playwright-core": "^1.64.1",
		"postgres": "^3.4.9",
		"resend": "^6.34.1",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^4.1.12",
		"bits-ui": "^2.20.0",
		"cloakbrowser": "^0.5.12",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"ipaddr.js": "^2.5.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-dnd-action": "^0.9.80",
		"tailwindcss": "^4.3.3",
		"tough-cookie": "^6.0.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
