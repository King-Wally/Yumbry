# Change POSTGRES_PASSWORD before exposing this app beyond your local/trusted network.
POSTGRES_USER=chef
POSTGRES_PASSWORD=changeme
POSTGRES_DB=recipe_vault
APP_PORT=3000
# Host port Postgres is published on. Only needs changing if another Postgres
# (or a second instance of this stack) already occupies 5432 on this machine.
# POSTGRES_PORT=5432
DATABASE_URL=postgres://chef:changeme@db:5432/recipe_vault

# Only used when running the backend directly (outside Docker) or the test suite.
# Inside docker-compose, PORT and UPLOADS_DIR are set by the Dockerfile/image instead.
# PORT=3000
# UPLOADS_DIR=./uploads
# TEST_DATABASE_URL=postgres://chef:changeme@localhost:5432/recipe_vault_test

# Required: signs and encrypts better-auth's session cookies and tokens.
# Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-value

# The public origin this app is served from, e.g. https://recipes.example.com.
# No trailing slash. Falls back to APP_BASE_URL when unset.
# BETTER_AUTH_URL=https://recipes.example.com

# Optional: enables the AI recipe assistant for every user, via OpenRouter
# (https://openrouter.ai/settings/keys). Leave unset to disable the assistant entirely.
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: enables nutrition estimates, which call Google Gemini directly rather
# than going through OpenRouter (https://aistudio.google.com/apikey). Leave unset
# to disable nutrition estimates only; the rest of the assistant keeps working.
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which OpenRouter models the assistant uses, per task. Model ids are
# listed at https://openrouter.ai/models. Defaults shown below apply when unset.
#   BIG    — the first message of a new recipe, written from scratch
#   MEDIUM — every later message, and every edit of an existing recipe
#   SMALL  — nutrition estimates (a Gemini API model id, not an OpenRouter one)
#   IMAGE  — reading a recipe from an uploaded photo (must accept image input)
# AI_MODEL_BIG=google/gemini-3.6-flash
# AI_MODEL_MEDIUM=google/gemini-3.5-flash-lite
# AI_MODEL_SMALL=gemini-3.5-flash-lite
# AI_MODEL_IMAGE=google/gemini-3.6-flash

# Optional: caps what the AI assistant spends on OpenRouter. The monthly budget
# (in USD) accrues one day's share at a time, and whatever a day leaves unused
# carries over to the next, until the budget resets on the 1st (UTC). Chat and
# photo import answer 429 once it is spent. AI_USER_DAILY_BUDGET_USD caps what a
# single user can spend per UTC day, so one account can't drain the pool for
# everyone; it defaults to three days' share, and 0 switches it off.
# Also set a matching credit limit with a monthly reset on the key itself
# (https://openrouter.ai/settings/keys): it's the hard stop if a request ever
# goes unrecorded here.
# AI_MONTHLY_BUDGET_USD=1
# AI_USER_DAILY_BUDGET_USD=

# Optional: nutrition estimates stop for the day after this many Gemini
# requests, counted per Pacific-time day like Google's free tier (500/day).
# GEMINI_DAILY_REQUEST_LIMIT=450

# Only set this to "true" if a reverse proxy in front of this app terminates
# TLS (HTTPS). Leave unset for the default plain-HTTP LAN deployment — a
# `secure` cookie is silently never sent back by the browser over HTTP, which
# would break login entirely.
# COOKIE_SECURE=true

# Optional: enables "forgot password" emails via Resend. Leave all three of these unset to
# disable the feature entirely — the login page hides the "forgot password" link, and
# /api/auth/forget-password quietly no-ops, when any of them is missing.

# Resend API key. Create one at https://resend.com/api-keys
# RESEND_API_KEY=re_your_api_key_here

# The "From" address for password-reset emails. Must use a domain verified in your Resend
# account (https://resend.com/domains) — Resend rejects sends from an unverified domain.
# EMAIL_FROM="Yumbry <no-reply@yourdomain.com>"

# The public base URL of this app, used to build the link inside password-reset emails
# (e.g. https://recipes.example.com). No trailing slash.
# APP_BASE_URL=https://recipes.example.com
