# Change POSTGRES_PASSWORD before exposing this app beyond your local/trusted network.
POSTGRES_USER=chef
POSTGRES_PASSWORD=changeme
POSTGRES_DB=recipe_vault
APP_PORT=3000
DATABASE_URL=postgres://chef:changeme@db:5432/recipe_vault

# Only used when running the backend directly (outside Docker) or the test suite.
# Inside docker-compose, PORT and UPLOADS_DIR are set by the Dockerfile/image instead.
# PORT=3000
# UPLOADS_DIR=./uploads
# TEST_DATABASE_URL=postgres://chef:changeme@localhost:5432/recipe_vault_test

# Optional: seeds the initial Ollama address/model on first boot only (see
# backend/src/services/ai-settings.service.ts's seedAiSettingsFromEnv). After
# that, use the Settings page in the app — these env vars are ignored once a
# value has been set there.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
