# Change POSTGRES_PASSWORD before exposing this app beyond your local/trusted network.
POSTGRES_USER=chef
POSTGRES_PASSWORD=changeme
POSTGRES_DB=recipe_vault
APP_PORT=3000
DATABASE_URL=postgres://chef:changeme@db:5432/recipe_vault

# Only used when running the backend directly (outside Docker) or the test suite.
# Inside docker-compose, PORT and UPLOADS_DIR are set by the Dockerfile/image instead.
# PORT=3000
# UPLOADS_DIR=./uploads
# TEST_DATABASE_URL=postgres://chef:changeme@localhost:5432/recipe_vault_test

# Required: signs the JWT stored in the login cookie.
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-value

# Required: encrypts each user's AI provider API key at rest in the database.
# Generate one with:
#   openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-value

# Only set this to "true" if a reverse proxy in front of this app terminates
# TLS (HTTPS). Leave unset for the default plain-HTTP LAN deployment — a
# `secure` cookie is silently never sent back by the browser over HTTP, which
# would break login entirely.
# COOKIE_SECURE=true

# Required: Resend API key used to send password-reset emails.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Required: the "From" address for password-reset emails. Must use a domain
# verified in your Resend account (https://resend.com/domains) — Resend
# rejects sends from an unverified domain.
EMAIL_FROM="Yumbry <no-reply@yourdomain.com>"

# Required: the public base URL of this app, used to build the link inside
# password-reset emails (e.g. https://recipes.example.com). No trailing slash.
APP_BASE_URL=https://recipes.example.com

# Optional: tuning for the built-in `llama` service (local Gemma AI provider).
# LLAMACPP_QUANT picks the GGUF quantization pulled from Hugging Face —
# Q4_0 (default, ~2.8GB) / Q8_0 (~5GB) / BF16 (~9.3GB, highest quality). Note
# this Q4_0 is quantization-aware-trained by Google, so it's already close to
# Q8_0 quality at under half the size — Q8_0 is a modest gain, BF16 rarely
# worth double the RAM and noticeably slower on CPU.
# LLAMA_PORT exposes its OpenAI-compatible API to the host for debugging
# (e.g. `curl localhost:8081/v1/models`) — the app itself always reaches it
# over the Docker network regardless of this port. It's bound to 127.0.0.1,
# since llama-server has no authentication of its own.
# LLAMACPP_QUANT=Q4_0
# LLAMA_PORT=8081

# LLAMACPP_MODEL_SIZE switches the built-in model from Gemma 4 E2B (default)
# to the larger E4B — the single biggest quality lever available for the
# built-in provider, at the cost of roughly double the weights (~4.6GB vs
# ~2.8GB at Q4_0) and proportionally slower generation on CPU. Only set this
# if your machine has several GB of RAM to spare beyond what E2B needs — e.g.
# NOT on a Raspberry Pi or another ~8GB-RAM box also running Postgres and the
# app itself.
# LLAMACPP_MODEL_SIZE=E4B

# LLAMA_CTX_SIZE is the context window (in tokens) reserved for the built-in
# model. The default (8192) comfortably covers a multi-turn recipe chat;
# raise it if you enable longer conversations or add context (e.g. reference
# recipes) and have the RAM to spare.
# LLAMA_CTX_SIZE=8192

# LLAMA_THREADS pins the built-in model to a specific CPU thread count
# instead of auto-detecting one. On constrained hardware (e.g. a Raspberry
# Pi also running Postgres and the app), set this to your number of physical
# cores — going above that reliably hurts rather than helps.
# LLAMA_THREADS=4
