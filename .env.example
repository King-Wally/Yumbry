# Change POSTGRES_PASSWORD before exposing this app beyond your local/trusted network.
POSTGRES_USER=chef
POSTGRES_PASSWORD=changeme
POSTGRES_DB=recipe_vault
APP_PORT=3000
DATABASE_URL=postgres://chef:changeme@db:5432/recipe_vault

# Only used when running the backend directly (outside Docker) or the test suite.
# Inside docker-compose, PORT and UPLOADS_DIR are set by the Dockerfile/image instead.
# PORT=3000
# UPLOADS_DIR=./uploads
# TEST_DATABASE_URL=postgres://chef:changeme@localhost:5432/recipe_vault_test

# Required: signs the JWT stored in the login cookie.
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-value

# Optional: enables the AI recipe assistant for every user, via Google Gemini
# (https://aistudio.google.com/apikey). Leave unset to disable the assistant entirely.
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini models the assistant uses. The "big" model is spent only
# on the first message of a new recipe, where the whole recipe is written from
# scratch; every later message and every edit of an existing recipe uses the
# "small" one — which is also where requests fall back to when the big model runs
# out of quota. Defaults shown below apply when unset.
# GEMINI_MODEL_BIG=gemini-3.6-flash
# GEMINI_MODEL_SMALL=gemini-3.5-flash-lite

# Only set this to "true" if a reverse proxy in front of this app terminates
# TLS (HTTPS). Leave unset for the default plain-HTTP LAN deployment — a
# `secure` cookie is silently never sent back by the browser over HTTP, which
# would break login entirely.
# COOKIE_SECURE=true

# Required: Resend API key used to send password-reset emails.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Required: the "From" address for password-reset emails. Must use a domain
# verified in your Resend account (https://resend.com/domains) — Resend
# rejects sends from an unverified domain.
EMAIL_FROM="Yumbry <no-reply@yourdomain.com>"

# Required: the public base URL of this app, used to build the link inside
# password-reset emails (e.g. https://recipes.example.com). No trailing slash.
APP_BASE_URL=https://recipes.example.com
