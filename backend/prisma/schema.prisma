generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A household. Recipes, tags and categories are scoped to a family, not to a
/// single user — every member sees and edits the same collection. Every user
/// gets a personal family of one at registration, so familyId is never absent.
model Family {
  id          Int      @id @default(autoincrement())
  /// Stored raw rather than hashed (unlike better-auth's Verification.value):
  /// the settings page has to re-display the same stable invite link on every
  /// visit, which a one-way hash cannot support.
  inviteToken String   @unique @map("invite_token")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  members    User[]
  recipes    Recipe[]
  tags       Tag[]
  categories Category[]

  @@map("families")
}

/// Owned by better-auth: `id`, `name`, `email`, `emailVerified` and `image` are
/// its core columns, and the rest are declared as `additionalFields` in
/// src/auth.ts. The password hash lives on Account, not here.
model User {
  id                      String   @id
  name                    String
  email                   String   @unique
  emailVerified           Boolean  @default(false) @map("email_verified")
  image                   String?
  locale                  String   @default("en") @map("locale")
  unitSystem              String   @default("metric") @map("unit_system")
  smallVolumes            String   @default("spoons") @map("small_volumes")
  jsonImportExportEnabled Boolean  @default(false) @map("json_import_export_enabled")
  familyId                Int      @map("family_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Restrict, not Cascade: deleting a family must never delete its members.
  // Families are only ever deleted once their member count reaches zero.
  family          Family    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  authoredRecipes Recipe[]  @relation("RecipeAuthor")
  sessions        Session[]
  accounts        Account[]

  @@index([familyId], map: "idx_users_family_id")
  @@map("users")
}

/// better-auth session rows. These replace the old tokenVersion counter: an
/// individual session is revoked by deleting its row, and "log out everywhere"
/// deletes all of a user's rows.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

/// A credential or linked provider for a user. With email+password as the only
/// enabled method, each user has exactly one row here with providerId
/// 'credential' and the scrypt hash in `password`.
model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

/// Short-lived tokens — password resets, in this app. Replaces the hand-written
/// PasswordResetToken model and its hourly cleanup interval; better-auth expires
/// these itself.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verifications")
}

model Recipe {
  id               Int      @id @default(autoincrement())
  title            String
  description      String?
  imagePath        String?  @map("image_path")
  prepTimeMinutes  Int?     @map("prep_time_minutes")
  cookTimeMinutes  Int?     @map("cook_time_minutes")
  totalTimeMinutes Int?     @map("total_time_minutes")
  servings         Decimal  @default(1)
  categoryId       Int?     @map("category_id")
  familyId         Int      @map("family_id")
  /// Provenance only — nothing authorises on this. Access is decided by
  /// familyId, and the recipe outlives its author (SetNull) so that leaving or
  /// deleting an account doesn't take the family's recipes with it.
  authorId         String?  @map("author_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author       User?         @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  ingredients  Ingredient[]
  instructions Instruction[]
  recipeTags   RecipeTag[]

  @@index([categoryId], map: "idx_recipes_category_id")
  @@index([familyId], map: "idx_recipes_family_id")
  @@index([authorId], map: "idx_recipes_author_id")
  @@map("recipes")
}

model Ingredient {
  id         Int      @id @default(autoincrement())
  recipeId   Int      @map("recipe_id")
  rawText    String   @map("raw_text")
  amount     Decimal?
  unit       String?
  name       String
  isScalable Boolean  @default(true) @map("is_scalable")
  sortOrder  Int      @map("sort_order")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId], map: "idx_ingredients_recipe_id")
  @@map("ingredients")
}

model Instruction {
  id         Int    @id @default(autoincrement())
  recipeId   Int    @map("recipe_id")
  stepNumber Int    @map("step_number")
  text       String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId], map: "idx_instructions_recipe_id")
  @@map("instructions")
}

model Tag {
  id       Int    @id @default(autoincrement())
  name     String
  familyId Int    @map("family_id")

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipeTags RecipeTag[]

  @@unique([familyId, name], map: "tags_family_id_name_key")
  @@index([familyId], map: "idx_tags_family_id")
  @@map("tags")
}

model RecipeTag {
  recipeId Int @map("recipe_id")
  tagId    Int @map("tag_id")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId], map: "idx_recipe_tags_tag_id")
  @@map("recipe_tags")
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String
  familyId Int    @map("family_id")

  family  Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipes Recipe[]

  @@unique([familyId, name], map: "categories_family_id_name_key")
  @@index([familyId], map: "idx_categories_family_id")
  @@map("categories")
}
